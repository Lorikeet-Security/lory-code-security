/* lory-code-security cockpit.
 *
 * Three columns: findings list, finding detail, Lory. Severity colours match
 * the Rich renderers in ui/render.py so a finding looks the same whichever
 * surface you read it on.
 *
 * Layout rule that matters: the two content panes scroll vertically and never
 * horizontally. Anything wide (a table, a code lead, a long URL) wraps or is
 * clipped inside its own pane rather than pushing the row sideways.
 */

Screen {
    background: $surface;
}

/* `root` holds the panes plus the status line; Footer docks below it. */
#root {
    height: 1fr;
}

#body {
    height: 1fr;
}

/* -- left: the finding list ---------------------------------------------- */

/* The three panes must fit the terminal, not the sum of their preferred
 * widths. A fixed sidebar plus a fixed Lory pane left the middle pane's
 * min-width unsatisfiable on a narrow terminal, and the compositor resolved
 * that by running the rightmost pane off the edge: text there was cropped
 * mid-word and read as a wrapping bug. The two content panes now share the
 * remainder as fractions, and every minimum is small enough that all three
 * fit side by side at 100 columns. */
#sidebar {
    width: 1fr;
    min-width: 26;
    max-width: 48;
    border-right: solid $panel-lighten-2;
}

#filter {
    border: none;
    background: $panel;
    height: 3;
}

#findings-table {
    height: 1fr;
    width: 1fr;
    overflow-x: hidden;
}

#counts {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

/* -- middle: the selected finding ---------------------------------------- */

#detail-pane {
    width: 1fr;
    min-width: 30;
}

#detail-scroll {
    height: 1fr;
    padding: 0 1;
    overflow-x: hidden;
    scrollbar-size-vertical: 1;
}

#detail {
    width: 1fr;
    height: auto;
}

/* -- right: Lory --------------------------------------------------------- */

#lory-pane {
    width: 1fr;
    min-width: 34;
    max-width: 64;
    border-left: solid $panel-lighten-2;
    display: none;
}

#lory-pane.visible {
    display: block;
}

#lory-scroll {
    height: 1fr;
    padding: 1 1 0 1;
    overflow-x: hidden;
    scrollbar-size-vertical: 1;
}

/* The empty state stays top-aligned and wraps naturally.
 *
 * Centring it was tried and reverted: both `content-align` and container
 * `align` size the child to its natural width, so the paragraph overflowed
 * the pane and was clipped at its 34-column minimum rather than wrapping. A
 * readable invitation beats a vertically centred one. */
#lory-intro {
    width: 1fr;
    height: auto;
}

/* Each turn hangs off a coloured rule: the transcript's spine. Whose turn it
 * is has to survive a fifty-line answer scrolling past. */
.lory-message {
    width: 1fr;
    height: auto;
    margin-bottom: 1;
    padding: 0 0 0 1;
    border-left: solid $panel-lighten-2;
}

.lory-message.from-user {
    border-left: solid $panel-lighten-3;
    color: $text-muted;
}

.lory-message.from-lory {
    border-left: solid $accent;
}

#lory-input {
    border: none;
    border-top: solid $panel-lighten-2;
    background: $panel;
    height: 3;
}

#lory-input:focus {
    border-top: solid $accent;
    background: $panel-lighten-1;
}

/* -- chrome -------------------------------------------------------------- */

/* Titles carry an accent marker rather than a full-width rule beneath them: a
 * band across all three panes drew more attention than the labels did. */
.pane-title {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $accent;
    text-style: bold;
}

#status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

DataTable > .datatable--cursor {
    background: $accent 30%;
}

DataTable > .datatable--header {
    background: $panel;
    color: $accent;
    text-style: bold;
}

/* -- confirmation modal -------------------------------------------------- */

ConfirmScreen {
    align: center middle;
    background: $surface 60%;
}

#confirm-box {
    width: 70;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    background: $panel;
    border: thick $warning;
}

#confirm-question {
    text-style: bold;
    padding-bottom: 1;
}

#confirm-detail {
    color: $text-muted;
    padding-bottom: 1;
}
