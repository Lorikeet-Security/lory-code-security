/* lory-code-security cockpit.
 *
 * Three columns: findings list, finding detail, Lory. Severity colours match
 * the Rich renderers in ui/render.py so a finding looks the same whichever
 * surface you read it on.
 *
 * Layout rule that matters: the two content panes scroll vertically and never
 * horizontally. Anything wide (a table, a code lead, a long URL) wraps or is
 * clipped inside its own pane rather than pushing the row sideways.
 */

Screen {
    background: $surface;
}

/* `root` holds the panes plus the status line; Footer docks below it. */
#root {
    height: 1fr;
}

#body {
    height: 1fr;
}

/* -- left: the finding list ---------------------------------------------- */

#sidebar {
    width: 44;
    min-width: 30;
    max-width: 60;
    border-right: solid $panel-lighten-2;
}

#filter {
    border: none;
    background: $panel;
    height: 3;
}

#findings-table {
    height: 1fr;
    width: 1fr;
    overflow-x: hidden;
}

#counts {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

/* -- middle: the selected finding ---------------------------------------- */

#detail-pane {
    width: 1fr;
    min-width: 40;
}

#detail-scroll {
    height: 1fr;
    padding: 0 1;
    overflow-x: hidden;
    scrollbar-size-vertical: 1;
}

#detail {
    width: 1fr;
    height: auto;
}

/* -- right: Lory --------------------------------------------------------- */

#lory-pane {
    width: 54;
    min-width: 34;
    max-width: 80;
    border-left: solid $panel-lighten-2;
    display: none;
}

#lory-pane.visible {
    display: block;
}

#lory-scroll {
    height: 1fr;
    padding: 0 1;
    overflow-x: hidden;
    scrollbar-size-vertical: 1;
}

#lory-intro {
    width: 1fr;
    height: auto;
}

.lory-message {
    width: 1fr;
    height: auto;
    margin-bottom: 1;
}

#lory-input {
    border: none;
    background: $panel;
    height: 3;
}

/* -- chrome -------------------------------------------------------------- */

.pane-title {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $accent;
    text-style: bold;
}

#status {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}

DataTable > .datatable--cursor {
    background: $accent 30%;
}

DataTable > .datatable--header {
    background: $panel;
    color: $accent;
    text-style: bold;
}

/* -- confirmation modal -------------------------------------------------- */

ConfirmScreen {
    align: center middle;
    background: $surface 60%;
}

#confirm-box {
    width: 70;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    background: $panel;
    border: thick $warning;
}

#confirm-question {
    text-style: bold;
    padding-bottom: 1;
}

#confirm-detail {
    color: $text-muted;
    padding-bottom: 1;
}
